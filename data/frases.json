{"situaciones":[{"id":"taverna","label":"En la taberna","phrases":[["Ένα τραπέζι για δύο, παρακαλώ.","Una mesa para dos, por favor."],["Έχετε τραπέζι έξω;","¿Tienen mesa fuera?"],["Τον κατάλογο, παρακαλώ.","La carta, por favor."],["Τι προτείνετε;","¿Qué recomienda?"],["Ποιο είναι το πιάτο της ημέρας;","¿Cuál es el plato del día?"],["Θα ήθελα μια χωριάτικη σαλάτα.","Querría una ensalada griega."],["Για μένα, το χταπόδι.","Para mí, el pulpo."],["Μισό κιλό κρασί, παρακαλώ.","Medio kilo de vino, por favor. (¡en las tabernas el vino se pide por kilos!)"],["Λίγο νερό ακόμα, παρακαλώ.","Un poco más de agua, por favor."],["Στην υγειά μας!","¡A nuestra salud!"],["Ήταν πολύ νόστιμο.","Estaba muy rico."],["Τον λογαριασμό, παρακαλώ.","La cuenta, por favor."],["Πόσο κάνει;","¿Cuánto es?"],["Κρατήστε τα ρέστα.","Quédese el cambio."]]},{"id":"cafe","label":"En el café","phrases":[["Έναν ελληνικό καφέ, παρακαλώ.","Un café griego, por favor."],["Ένα φρέντο εσπρέσο, μέτριο.","Un freddo espresso, medio de azúcar."],["Σκέτο, μέτριο ή γλυκό;","¿Solo, medio o dulce? (los tres niveles de azúcar)"],["Με γάλα, παρακαλώ.","Con leche, por favor."],["Χωρίς ζάχαρη.","Sin azúcar."],["Για εδώ ή για έξω;","¿Para aquí o para llevar?"],["Έχετε γλυκά;","¿Tienen dulces?"],["Ένα κομμάτι μπακλαβά.","Un trozo de baklava."],["Έχετε wifi; Ποιος είναι ο κωδικός;","¿Tienen wifi? ¿Cuál es la contraseña?"],["Θα καθίσουμε εδώ.","Nos sentamos aquí."]]},{"id":"conocer","label":"Conocer gente","phrases":[["Πώς σε λένε;","¿Cómo te llamas?"],["Με λένε Ντάνι.","Me llamo Dani."],["Από πού είσαι;","¿De dónde eres?"],["Είμαι από τη Βαρκελώνη.","Soy de Barcelona."],["Χαίρω πολύ!","¡Encantado!"],["Τι δουλειά κάνεις;","¿A qué te dedicas?"],["Δουλεύω με δεδομένα.","Trabajo con datos."],["Μαθαίνω ελληνικά.","Estoy aprendiendo griego."],["Μιλάς αγγλικά;","¿Hablas inglés?"],["Μιλάω λίγα ελληνικά.","Hablo un poco de griego."],["Πιο σιγά, παρακαλώ.","Más despacio, por favor."],["Δεν κατάλαβα. Μπορείς να το πεις ξανά;","No he entendido. ¿Puedes repetirlo?"],["Πώς λέγεται αυτό στα ελληνικά;","¿Cómo se dice esto en griego?"],["Έχεις παιδιά; — Ναι, ένα μωρό.","¿Tienes hijos? — Sí, un bebé."]]},{"id":"direcciones","label":"Direcciones","phrases":[["Πού είναι η παραλία;","¿Dónde está la playa?"],["Πώς πάω στο κέντρο;","¿Cómo voy al centro?"],["Δεξιά.","A la derecha."],["Αριστερά.","A la izquierda."],["Ευθεία.","Recto."],["Στη γωνία.","En la esquina."],["Είναι κοντά ή μακριά;","¿Está cerca o lejos?"],["Πέντε λεπτά με τα πόδια.","Cinco minutos a pie."],["Είμαι χαμένος.","Estoy perdido."],["Απέναντι από την πλατεία.","Enfrente de la plaza."],["Δίπλα στην εκκλησία.","Al lado de la iglesia."],["Πού είναι η στάση του λεωφορείου;","¿Dónde está la parada del autobús?"]]},{"id":"compras","label":"Compras","phrases":[["Πόσο κοστίζει αυτό;","¿Cuánto cuesta esto?"],["Είναι πολύ ακριβό.","Es muy caro."],["Έχετε κάτι πιο φτηνό;","¿Tiene algo más barato?"],["Θα το πάρω.","Me lo llevo."],["Απλώς κοιτάω, ευχαριστώ.","Solo estoy mirando, gracias."],["Μπορώ να το δοκιμάσω;","¿Puedo probármelo?"],["Έχετε μεγαλύτερο νούμερο;","¿Tiene una talla más grande?"],["Μπορώ να πληρώσω με κάρτα;","¿Puedo pagar con tarjeta?"],["Μόνο μετρητά.","Solo efectivo."],["Μια απόδειξη, παρακαλώ.","Un recibo, por favor."],["Τι ώρα ανοίγετε / κλείνετε;","¿A qué hora abren / cierran?"],["Μισό κιλό ελιές, παρακαλώ.","Medio kilo de aceitunas, por favor."]]},{"id":"hotel","label":"Hotel y viaje","phrases":[["Έχω κράτηση στο όνομα Ντάνι.","Tengo una reserva a nombre de Dani."],["Ένα δωμάτιο με θέα στη θάλασσα;","¿Una habitación con vistas al mar?"],["Για τρεις νύχτες.","Para tres noches."],["Τι ώρα είναι το πρωινό;","¿A qué hora es el desayuno?"],["Το κλειδί, παρακαλώ.","La llave, por favor."],["Το κλιματιστικό δεν δουλεύει.","El aire acondicionado no funciona."],["Τι ώρα φεύγει το πλοίο;","¿A qué hora sale el barco?"],["Ένα εισιτήριο για την Αθήνα.","Un billete para Atenas."],["Πόση ώρα κάνει το ταξίδι;","¿Cuánto dura el viaje?"],["Μπορείτε να καλέσετε ένα ταξί;","¿Puede llamar a un taxi?"],["Πού μπορώ να νοικιάσω αυτοκίνητο;","¿Dónde puedo alquilar un coche?"],["Καλές διακοπές!","¡Felices vacaciones!"]]},{"id":"emergencias","label":"Emergencias","phrases":[["Βοήθεια!","¡Socorro!"],["Χρειάζομαι έναν γιατρό.","Necesito un médico."],["Πού είναι το νοσοκομείο;","¿Dónde está el hospital?"],["Πού είναι το φαρμακείο;","¿Dónde está la farmacia?"],["Πονάει εδώ.","Me duele aquí."],["Έχω πυρετό.","Tengo fiebre."],["Είμαι αλλεργικός σε...","Soy alérgico a..."],["Έχασα το πορτοφόλι μου.","He perdido mi cartera."],["Μου έκλεψαν την τσάντα.","Me han robado el bolso."],["Καλέστε την αστυνομία.","Llame a la policía."],["Είναι επείγον.","Es urgente."],["Μην ανησυχείτε, όλα καλά.","No se preocupe, todo bien."]]},{"id":"opiniones","label":"Opiniones y small talk","phrases":[["Τι νομίζεις;","¿Qué opinas?"],["Νομίζω ότι έχεις δίκιο.","Creo que tienes razón."],["Δεν συμφωνώ.","No estoy de acuerdo."],["Εξαρτάται.","Depende."],["Μου αρέσει πολύ.","Me gusta mucho."],["Δεν είναι κακό.","No está mal."],["Πλάκα κάνεις!","¡Estás de broma!"],["Σοβαρά;","¿En serio?"],["Τι γίνεται;","¿Qué tal? / ¿Qué pasa?"],["Όλα καλά, εσύ;","Todo bien, ¿y tú?"],["Έτσι κι έτσι.","Así así."],["Τι έκανες το σαββατοκύριακο;","¿Qué hiciste el fin de semana?"],["Ωραίος καιρός σήμερα, ε;","Buen tiempo hoy, ¿eh?"],["Σιγά σιγά.","Poco a poco. (la filosofía griega de la vida)"]]},{"id":"telefono","label":"Al teléfono","phrases":[["Εμπρός; / Ναι;","¿Diga? / ¿Sí?"],["Ποιος είναι;","¿Quién es?"],["Ο Ντάνι είμαι.","Soy Dani."],["Μπορώ να μιλήσω με τον...;","¿Puedo hablar con...?"],["Ένα λεπτό, παρακαλώ.","Un momento, por favor."],["Δεν σε ακούω καλά.","No te oigo bien."],["Θα σε πάρω μετά.","Te llamo luego."],["Πάρε με όταν μπορείς.","Llámame cuando puedas."],["Χάθηκε η γραμμή.","Se ha cortado la línea."],["Στείλε μου μήνυμα.","Mándame un mensaje."],["Μίλα πιο δυνατά.","Habla más alto."],["Τα λέμε το βράδυ.","Hablamos por la noche."]]},{"id":"aeropuerto","label":"En el aeropuerto","phrases":[["Πού είναι το τσεκ-ιν;","¿Dónde está el check-in?"],["Το διαβατήριό σας, παρακαλώ.","Su pasaporte, por favor."],["Έχετε αποσκευές;","¿Tiene equipaje?"],["Μόνο χειραποσκευή.","Solo equipaje de mano."],["Ποια είναι η πύλη;","¿Cuál es la puerta?"],["Η πτήση έχει καθυστέρηση.","El vuelo lleva retraso."],["Η πτήση ακυρώθηκε.","El vuelo se ha cancelado."],["Τι ώρα προσγειωνόμαστε;","¿A qué hora aterrizamos?"],["Έχασα τη βαλίτσα μου.","He perdido mi maleta."],["Πού είναι η παραλαβή αποσκευών;","¿Dónde está la recogida de equipajes?"],["Θέση δίπλα στο παράθυρο, παρακαλώ.","Asiento de ventanilla, por favor."],["Καλή πτήση!","¡Buen vuelo!"]]},{"id":"medico","label":"En el médico","phrases":[["Δεν νιώθω καλά.","No me encuentro bien."],["Πού πονάτε;","¿Dónde le duele?"],["Πονάει το στομάχι μου.","Me duele el estómago."],["Έχω πυρετό από χθες.","Tengo fiebre desde ayer."],["Βήχω πολύ.","Toso mucho."],["Είμαι κρυωμένος.","Estoy resfriado."],["Είστε αλλεργικός σε κάτι;","¿Es alérgico a algo?"],["Παίρνετε φάρμακα;","¿Toma medicamentos?"],["Ανοίξτε το στόμα.","Abra la boca."],["Πάρτε βαθιά ανάσα.","Respire hondo."],["Θα σας γράψω μια συνταγή.","Le voy a hacer una receta."],["Ένα χάπι δύο φορές τη μέρα.","Una pastilla dos veces al día."],["Περαστικά!","¡Que se mejore!"]]},{"id":"trabajo_frases","label":"En el trabajo","phrases":[["Έχουμε σύσκεψη στις δέκα.","Tenemos reunión a las diez."],["Μπορείς να μου στείλεις το αρχείο;","¿Puedes enviarme el archivo?"],["Το στέλνω τώρα.","Lo envío ahora."],["Ας το συζητήσουμε αύριο.","Hablémoslo mañana."],["Συμφωνώ με την πρόταση.","Estoy de acuerdo con la propuesta."],["Έχω πολλή δουλειά σήμερα.","Tengo mucho trabajo hoy."],["Η προθεσμία είναι την Παρασκευή.","El plazo es el viernes."],["Δουλεύω από το σπίτι σήμερα.","Hoy trabajo desde casa."],["Μπορούμε να κάνουμε ένα διάλειμμα;","¿Podemos hacer una pausa?"],["Καλή δουλειά όλοι!","¡Buen trabajo a todos!"],["Παίρνω άδεια την άλλη εβδομάδα.","Cojo vacaciones la semana que viene."],["Τα λέμε στη σύσκεψη.","Nos vemos en la reunión."]]},{"id":"casa_bebe","label":"En casa con el bebé","phrases":[["Το μωρό κοιμάται, σιγά!","El bebé duerme, ¡bajito!"],["Ξύπνησε πάλι.","Se ha despertado otra vez."],["Πεινάει, νομίζω.","Tiene hambre, creo."],["Ώρα για φαγητό!","¡Hora de comer!"],["Θέλει αγκαλιά.","Quiere brazos."],["Άλλαξες την πάνα;","¿Le has cambiado el pañal?"],["Πάμε βόλτα με το καροτσάκι.","Vamos de paseo con el carrito."],["Κοιμήθηκε επιτέλους!","¡Por fin se ha dormido!"],["Ποιος είναι το πιο όμορφο μωρό;","¿Quién es el bebé más bonito?"],["Έκανε τα πρώτα του βήματα!","¡Ha dado sus primeros pasos!"],["Είπε την πρώτη του λέξη.","Ha dicho su primera palabra."],["Ώρα για ύπνο, μωρό μου.","Hora de dormir, cariño."]]},{"id":"romantico","label":"Frases románticas","phrases":[["Σ'αγαπώ πολύ.","Te quiero mucho."],["Μου λείπεις.","Te echo de menos."],["Είσαι πολύ όμορφη απόψε.","Estás muy guapa esta noche."],["Θες να βγούμε για φαγητό;","¿Quieres que salgamos a cenar?"],["Πάμε μια βόλτα στο ηλιοβασίλεμα;","¿Damos un paseo al atardecer?"],["Ήταν μια τέλεια βραδιά.","Ha sido una noche perfecta."],["Είσαι η ζωή μου.","Eres mi vida."],["Καληνύχτα, αγάπη μου.","Buenas noches, mi amor."],["Όνειρα γλυκά.","Dulces sueños."],["Ευτυχισμένη επέτειο!","¡Feliz aniversario!"],["Χορεύουμε;","¿Bailamos?"],["Μαζί για πάντα.","Juntos para siempre."]]},{"id":"taxi","label":"En el taxi","phrases":[["Είστε ελεύθερος;","¿Está libre?"],["Στο κέντρο, παρακαλώ.","Al centro, por favor."],["Σε αυτή τη διεύθυνση.","A esta dirección."],["Πόσο κοστίζει μέχρι το αεροδρόμιο;","¿Cuánto cuesta hasta el aeropuerto?"],["Βάλτε το ταξίμετρο, παρακαλώ.","Ponga el taxímetro, por favor."],["Βιάζομαι λίγο.","Tengo un poco de prisa."],["Μπορείτε να πάτε πιο αργά;","¿Puede ir más despacio?"],["Εδώ είναι καλά.","Aquí está bien."],["Σταματήστε εδώ, παρακαλώ.","Pare aquí, por favor."],["Μου δίνετε απόδειξη;","¿Me da un recibo?"],["Κρατήστε τα ρέστα.","Quédese el cambio."]]},{"id":"tecnologia","label":"Problemas de tecnología","phrases":[["Δεν έχω ίντερνετ.","No tengo internet."],["Ποιος είναι ο κωδικός του wifi;","¿Cuál es la contraseña del wifi?"],["Ο υπολογιστής κόλλησε.","El ordenador se ha colgado."],["Κάνε επανεκκίνηση.","Reinícialo."],["Τελείωσε η μπαταρία μου.","Se me ha acabado la batería."],["Έχεις φορτιστή;","¿Tienes cargador?"],["Δεν ανοίγει η εφαρμογή.","No se abre la aplicación."],["Έστειλα το μέιλ, το πήρες;","Envié el correo, ¿lo has recibido?"],["Πήγε στα ανεπιθύμητα.","Se fue a spam."],["Κατέβασε την εφαρμογή.","Descarga la aplicación."],["Το σύστημα είναι κάτω.","El sistema está caído."],["Δούλεψε! Επιτέλους!","¡Funcionó! ¡Por fin!"]]},{"id":"clima_charla","label":"Charla sobre el tiempo","phrases":[["Τι καιρό κάνει σήμερα;","¿Qué tiempo hace hoy?"],["Κάνει πολλή ζέστη.","Hace mucho calor."],["Έχει λιακάδα.","Hace sol (hay solecito)."],["Λέει ότι θα βρέξει αύριο.","Dicen que lloverá mañana."],["Πάρε ομπρέλα.","Coge paraguas."],["Φυσάει πολύ σήμερα.","Hoy hace mucho viento."],["Τι κρύο!","¡Qué frío!"],["Ανυπομονώ για το καλοκαίρι.","Estoy deseando que llegue el verano."],["Τέλειος καιρός για παραλία.","Tiempo perfecto para la playa."],["Χάλασε ο καιρός.","Se ha estropeado el tiempo."],["Άνοιξε ο καιρός.","Ha mejorado el tiempo."]]},{"id":"panaderia","label":"Panadería y mercado","phrases":[["Ένα ψωμί, παρακαλώ.","Un pan, por favor."],["Φρέσκο είναι;","¿Está fresco?"],["Μόλις βγήκε από τον φούρνο.","Acaba de salir del horno."],["Δύο τυρόπιτες, παρακαλώ.","Dos empanadas de queso, por favor."],["Μία σπανακόπιτα και ένα κουλούρι.","Una empanada de espinacas y una rosquilla de sésamo."],["Πόσο έχουν οι ντομάτες;","¿A cuánto están los tomates?"],["Δύο ευρώ το κιλό.","A dos euros el kilo."],["Βάλε μου ένα κιλό.","Ponme un kilo."],["Είναι ντόπια τα φρούτα;","¿Es fruta local?"],["Δοκίμασε, είναι γλυκό σαν μέλι.","Prueba, está dulce como la miel."],["Τίποτα άλλο;","¿Algo más?"],["Αυτά, ευχαριστώ.","Eso es todo, gracias."]]}]}